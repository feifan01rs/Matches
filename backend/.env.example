# 把本文件复制成 backend/.env，填上你自己的 Key，后端就能抓到真实数据了。
# 没有 Key 也能启动，只是对应项目暂时没有数据。

# 足球数据：https://www.football-data.org/  （注册后在个人页面能看到）
FOOTBALL_DATA_KEY=

# 电竞数据：https://www.pandascore.co/  （注册后在账号设置里能看到）
PANDASCORE_KEY=

# 抓取间隔（分钟），不改就是 10
 FETCH_INTERVAL_MINUTES=5

# 端口，不改就是 8787
# PORT=8080

# ── 羽毛球 ──────────────────────────────────────────────
# 羽毛球不用注册、不用 Key（走 BWF 官方站内接口）。
# 但它需要系统里有 curl 命令：Windows 10/11 自带，无需安装。
# 想临时关掉羽毛球就设 BWF_ON=0
# BWF_ON=1
# BWF_MAX_TOURNAMENTS=30
