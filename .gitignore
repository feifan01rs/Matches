# ============================================================
#  海风看球 · 观赛预告
#  规则说明：凡是被这里匹配到的文件，git 都不会纳入管理
# ============================================================

# ---------- 依赖 ----------
# 本项目目前「零依赖」（数据库用 Node 自带的 node:sqlite），
# 这行只是以防以后装了别的包
node_modules/

# ---------- 本地配置：里面有 API Key，绝对不要提交 ----------
# backend/.env 放 FOOTBALL_DATA_KEY / PANDASCORE_KEY
.env

# ---------- 运行时生成的数据库 ----------
# 后端启动时会自动重建，不需要（也不应该）进版本库
backend/data.db
backend/data.db-journal
backend/data.db-wal
backend/data.db-shm

# ---------- 日志 / 临时文件 ----------
*.log
*.tmp

# ---------- 编辑器 / 系统 ----------
# .idea 是 IDE 自己的配置，其中 dataSources.xml 可能带着数据库连接信息
.idea/
.vscode/
.DS_Store
Thumbs.db
